{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*\\.xml)", "destination": "/$1" },
    { "source": "/llms.txt", "destination": "/llms.txt" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
