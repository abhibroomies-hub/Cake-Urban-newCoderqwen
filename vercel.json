{
  "headers": [
    {
      "source": "/(.*\\.xml)",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap?type=main" },
    { "source": "/sitemap-main.xml", "destination": "/api/sitemap?type=main" },
    { "source": "/sitemap-:type.xml", "destination": "/api/sitemap?type=:type" },
    { "source": "/((?!api/|sitemap.*\\.xml|.*\\.xml$|robots\\.txt$|llms\\.txt$|assets/).*)", "destination": "/index.html" }
  ]
}
